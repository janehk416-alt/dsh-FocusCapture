{
  "name": "@local/dsh-focuscapture",
  "version": "1.4.0",
  "displayName": "dsh-FocusCapture",
  "private": true,
  "description": "dsh-FocusCapture: compact screen capture, screenshot-background text editing, annotations, and always-on-top pinned images.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janehk416-alt/dsh-FocusCapture.git"
  },
  "homepage": "https://github.com/janehk416-alt/dsh-FocusCapture#readme",
  "bugs": {
    "url": "https://github.com/janehk416-alt/dsh-FocusCapture/issues"
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "screenshot", "screen-capture", "annotation", "windows"],
  "icon": "icon.png",
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "exports": {
    ".": "./host-v1.1.js",
    "./host-v1.1": "./host-v1.1.js",
    "./host-v1.1/icon": "./icon.png",
    "./host-v1.1/locale/*.json": "./locale/*.json",
    "./client": "./client.js",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "host-v1.1.js", "core.js", "runtime.js", "hotkey.js", "settings.js", "client.js", "delivery.js", "native/Snip.cs", "native/Drawing.cs", "native/RegionEditor.cs", "native/EditorUi.cs", "native/ScreenshotTextBox.cs", "native/PinnedShot.cs", "native/EditorTests.cs", "native/Typography.cs", "native/keyboard-worker.py", "native/keyboard-runtime.json", "native/DualCtrlSnip.exe", "native/fonts/*.ttf", "native/fonts/OFL.txt", "cordis.patch.yml", "locale/*.json", "icon.png", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build:release": "python scripts/release.py build"
  }
}
